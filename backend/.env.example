# Groq (LLM with tool calling). Get a key at console.groq.com
GROQ_API_KEY=
# Pick a current tool-calling model from the Groq console model list
GROQ_MODEL=

# Sarvam (speech-to-text and text-to-speech). Get a key from the Sarvam dashboard
SARVAM_API_KEY=

# App
DATABASE_URL=sqlite:///./saathi.db
MOCK_API_BASE=http://localhost:8000/mock
CONFIDENCE_THRESHOLD=0.75
HEARTBEAT_STALE_SECONDS=120
ALLOWED_ORIGINS=http://localhost:3000
